rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name',
          'description',
          'price',
          'imageUrl',
          'category',
          'stock',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 3000
        && data.price is number
        && data.price > 0
        && data.price <= 500000
        && data.imageUrl is string
        && data.category is string
        && data.category.size() <= 80
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 100000
        && data.active is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /products/{productId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function isOrderOwner() {
      return request.auth != null
        && resource.data.userId is string
        && resource.data.userId == request.auth.uid;
    }

    // Checkout writes and payment updates remain server-only. A signed-in
    // customer may read only orders linked to their own Firebase UID.
    match /orders/{orderId} {
      allow get, list: if isAdmin() || isOrderOwner();
      allow create, update, delete: if isAdmin();
    }
  }
}
