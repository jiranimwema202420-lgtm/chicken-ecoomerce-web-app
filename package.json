{
    "name":  "ecommerce-app",
    "version":  "0.1.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=20.9.0"
                },
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint .",
                    "set-admin":  "node scripts/setAdminClaim.mjs",
                    "check":  "npm run lint \u0026\u0026 npm run typecheck",
                    "typecheck":  "tsc --noEmit",
                    "seed":  "node scripts/seedProducts.mjs",
                    "seed:broilers":  "node scripts/seedBroilerProducts.mjs",
                    "validate":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run build",
                    "version:show":  "node scripts/version/show-version.mjs",
                    "release:patch":  "node scripts/version/release.mjs patch",
                    "release:minor":  "node scripts/version/release.mjs minor",
                    "release:major":  "node scripts/version/release.mjs major",
                    "release:check":  "npm run validate \u0026\u0026 npm run version:show",
                    "rbac:set-role":  "node scripts/set-user-role.mjs",
                    "rules:deploy":  "npx firebase-tools deploy --only firestore:rules",
                    "rules:emulator":  "npx firebase-tools emulators:start --only firestore"
                },
    "dependencies":  {
                         "axios":  "^1.7.9",
                         "clsx":  "^2.1.1",
                         "firebase":  "^11.1.0",
                         "lucide-react":  "^0.469.0",
                         "next":  "^15.1.4",
                         "posthog-js":  "^1.407.2",
                         "posthog-node":  "^5.46.1",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "zustand":  "^5.0.2"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.10.2",
                            "@types/react":  "^19.0.2",
                            "@types/react-dom":  "^19.0.2",
                            "autoprefixer":  "^10.4.20",
                            "dotenv":  "^16.4.7",
                            "eslint":  "^9.17.0",
                            "eslint-config-next":  "^15.1.4",
                            "firebase-admin":  "^13.0.2",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.7.2"
                        }
}
